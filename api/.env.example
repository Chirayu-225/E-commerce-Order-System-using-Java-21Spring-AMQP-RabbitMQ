# Copy to .env (or export) - every value has a working local default except in production.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://flashcart:flashcart@127.0.0.1:5432/flashcart
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-32-or-more-random-characters
WEBHOOK_SECRET=change-me-too
ORDER_TTL_SECONDS=600
REDIS_GATE_ENABLED=true
RATE_LIMIT_ENABLED=true
SEED_DEMO=true
