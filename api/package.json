{
  "name": "flashcart-api",
  "version": "1.0.0",
  "private": true,
  "description": "FlashCart API: flash-sale e-commerce backend (NestJS, PostgreSQL, Redis, RabbitMQ)",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/db/migrate-cli.js",
    "test": "jest --runInBand --forceExit",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "amqplib": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=22"
  }
}
